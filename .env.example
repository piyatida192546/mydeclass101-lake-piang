# Docker network shared with ClickHouse
DATA_PLATFORM_NETWORK=data-platform-network

# Host ports
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Replace these development examples before starting the service.
# Access keys should contain only uppercase ASCII letters and digits.
RUSTFS_ACCESS_KEY=RUSTFSADMIN01
RUSTFS_SECRET_KEY=change-this-to-a-long-random-secret
RUSTFS_LOG_LEVEL=error